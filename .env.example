# Copia este archivo a .env (scripts/setup.sh lo hace por ti). .env no se sube a git.

NODE_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=4000

# PostgreSQL (los mismos valores los usa docker-compose.yml)
POSTGRES_USER=goblins
POSTGRES_PASSWORD=goblins_dev_password
POSTGRES_DB=goblins
POSTGRES_PORT=5432
DATABASE_URL=postgresql://goblins:goblins_dev_password@127.0.0.1:5432/goblins

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Dominio base de la plataforma. En local los foros serán <nombre>.localhost
PLATFORM_BASE_DOMAIN=localhost

# Duración de una sesión iniciada, en horas (por defecto 7 días)
SESSION_TTL_HOURS=168
